<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" />
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <ProjectGuid>{C283A2CC-975C-4614-9D02-FF5EE83FA60C}</ProjectGuid>
    <OutputType>Library</OutputType><RootNamespace>AddinRibbon</RootNamespace><AssemblyName>AddinRibbon</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion><PlatformTarget>x64</PlatformTarget><LangVersion>7.3</LangVersion>
    <OutputPath>bin\$(Configuration)\</OutputPath><DebugSymbols>true</DebugSymbols><DebugType>pdbonly</DebugType>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize><WarningLevel>4</WarningLevel>
    <Deterministic>true</Deterministic>
    <NavisworksInstallDir Condition="'$(NavisworksInstallDir)' == ''">D:\Programs\Navisworks Manage 2027</NavisworksInstallDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Autodesk.Navisworks.Api"><HintPath>$(NavisworksInstallDir)\Autodesk.Navisworks.Api.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Autodesk.Navisworks.ComApi"><HintPath>$(NavisworksInstallDir)\Autodesk.Navisworks.ComApi.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Autodesk.Navisworks.Interop.ComApi"><HintPath>$(NavisworksInstallDir)\Autodesk.Navisworks.Interop.ComApi.dll</HintPath><Private>False</Private><EmbedInteropTypes>False</EmbedInteropTypes></Reference>
    <Reference Include="System" /><Reference Include="System.Core" /><Reference Include="System.Drawing" /><Reference Include="System.Numerics" />
    <Reference Include="System.Windows.Forms" /><Reference Include="System.Xml" /><Reference Include="System.Xml.Linq" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="ClAddin.cs" /><Compile Include="Ctr\PathFinderControl.cs" /><Compile Include="Routing\*.cs" />
    <Compile Include="Services\RoutingSession.cs" /><Compile Include="Services\TrayMeshReader.cs" /><Compile Include="Services\PathVisualization.cs" /><Compile Include="Services\RoutePathOverlay.cs" /><Compile Include="Properties\AssemblyInfo.cs" />
    <EmbeddedResource Include="AddinRibbon.xaml" />
    <Content Include="AddinRibbon.xaml"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="logo_16x16.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="logo_32x32.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>
  <Target Name="CheckNavisworksApi" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(NavisworksInstallDir)\Autodesk.Navisworks.Api.dll')" Text="Set NavisworksInstallDir to the Navisworks Manage 2027 installation directory." />
  </Target>
  <Target Name="CopyRibbonResources" AfterTargets="Build">
    <MakeDir Directories="$(OutputPath)en-US;$(OutputPath)Images" />
    <Copy SourceFiles="AddinRibbon.xaml" DestinationFolder="$(OutputPath)en-US" />
    <Copy SourceFiles="logo_16x16.png;logo_32x32.png" DestinationFolder="$(OutputPath)Images" />
  </Target>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
